# Copy to .env.local and fill in values from `supabase start` output.
# Required for local development with Supabase.

# Local Supabase (from `supabase start`)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=<anon key from supabase start>

# Optional: Mapbox for maps (app has a fallback token)
# VITE_MAPBOX_PUBLIC_TOKEN=pk.your_mapbox_token
